                        "pluginVersion": "4.22.1",
                        "queryType": "table",
                        "rawSql": "SELECT\r\n    concat(\r\n        'AS',\r\n        toString(src_as),\r\n        ' (',\r\n        coalesce(\r\n            nullIf(\r\n                argMaxIf(\r\n                    src_as_org,\r\n                    time_received,\r\n                    src_as_org != ''\r\n                ),\r\n                ''\r\n            ),\r\n            'Organization unknown'\r\n        ),\r\n        ')'\r\n    ) AS ASN,\r\n    sum(bytes) AS Bytes\r\nFROM netflow.flows\r\nWHERE\r\n  $__timeFilter(time_received) AND\r\n  src_as != 150986 AND\r\n  src_as != 0\r\nGROUP BY src_as\r\nORDER BY Bytes DESC\r\nLIMIT 10"
                      },
                      "labels": {
